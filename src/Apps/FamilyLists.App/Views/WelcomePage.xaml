<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyLists.App.ViewModels"
             x:Class="FamilyLists.App.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,48,24,32" Spacing="14">
                <Label Text="📝" FontSize="56" HorizontalOptions="Center" />
                <Label Text="Family Lists" Style="{StaticResource Heading}" FontSize="30" HorizontalOptions="Center" />
                <Label Text="Monthly groceries that copy forward, to-dos, and what you spent, shared with the people you live with. No accounts, free." HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource Card}" Padding="16" IsVisible="{Binding KeyLost}">
                    <Label Text="This phone's lists can't be opened any more (the phone's security key was reset). Start again, then join your group to get them back." TextColor="{StaticResource Danger}" />
                </Border>

                <Label Text="Your name" Style="{StaticResource SectionLabel}" />
                <Entry Text="{Binding Name}" Placeholder="e.g. Asha" MaxLength="40" />
                <Label Text="People in your group see this name." Style="{StaticResource Subtle}" />

                <Label Text="Your household's group" Style="{StaticResource SectionLabel}" />
                <Entry Text="{Binding GroupName}" Placeholder="Home" MaxLength="60" />
                <Button Text="Start" Command="{Binding StartCommand}" Margin="0,8,0,0" />

                <Label Text="Invited by someone?" Style="{StaticResource SectionLabel}" Margin="0,20,0,0" />
                <Label Text="If someone in your household already uses Family Lists, join their group instead." Style="{StaticResource Subtle}" />
                <Button Text="I have an invite" Command="{Binding InvitedCommand}" Style="{StaticResource OutlineButton}" />

                <Label Text="Your lists are stored encrypted on your phone. Phones in a group sync through a free relay (ntfy.sh) that only ever sees scrambled data." Style="{StaticResource Subtle}" Margin="0,16,0,0" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#66000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
