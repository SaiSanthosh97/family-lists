<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FamilyLists.App.ViewModels"
             x:Class="FamilyLists.App.Views.JoinPage"
             x:DataType="vm:JoinViewModel"
             Title="Join a group">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,8,16,32" Spacing="12">
                <VerticalStackLayout Spacing="12" IsVisible="{Binding Waiting, Converter={StaticResource Not}}">
                    <Label Text="Next to them" Style="{StaticResource SectionLabel}" />
                    <Label Text="Ask them to open Group → Show QR code, then take a photo of it." />
                    <Button Text="Scan the QR code" Command="{Binding ScanCommand}" />
                    <Label Text="Far away" Style="{StaticResource SectionLabel}" Margin="0,16,0,0" />
                    <Label Text="Copy the invite message they sent you (WhatsApp, SMS…), then tap below." />
                    <Button Text="Paste the invite" Command="{Binding PasteCommand}" Style="{StaticResource OutlineButton}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding Waiting}">
                    <Label Text="{Binding WaitingText}" />
                    <Border Style="{StaticResource Card}" Padding="20">
                        <Label Text="{Binding SafetyCode}" FontSize="40" FontFamily="OpenSansSemibold" HorizontalOptions="Center" CharacterSpacing="8" />
                    </Border>
                    <Button Text="Check if I'm in" Command="{Binding CheckCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#66000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
