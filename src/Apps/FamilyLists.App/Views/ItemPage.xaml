<?xml version="1.0" encoding="utf-8" ?>
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FamilyLists.App.Views"
             xmlns:vm="clr-namespace:FamilyLists.App.ViewModels"
             x:Class="FamilyLists.App.Views.ItemPage"
             x:DataType="vm:ItemViewModel"
             Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="8">
            <Label Text="Name" Style="{StaticResource SectionLabel}" />
            <Entry Text="{Binding Name}" MaxLength="120" />

            <!-- Expenses: amount, due day, due this month, paid -->
            <VerticalStackLayout IsVisible="{Binding IsExpense}" Spacing="8">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout>
                        <Label Text="{Binding PriceLabel}" Style="{StaticResource SectionLabel}" />
                        <Entry Text="{Binding Price}" Keyboard="Numeric" Placeholder="0.00" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Due day (optional)" Style="{StaticResource SectionLabel}" />
                        <Entry Text="{Binding DueDay}" Keyboard="Numeric" Placeholder="e.g. 5" MaxLength="2" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="Copied to next month with the amount and due day. The due day is the day of every month it's due." Style="{StaticResource Subtle}" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <Label Text="Due this month" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding DueThisMonth}" OnColor="{StaticResource Primary}" />
                </Grid>
                <Label Text="Turn off for one that isn't due this month (a quarterly fee, a skipped payment). It still comes back next month." Style="{StaticResource Subtle}" />
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding DueThisMonth}">
                    <Label Text="Paid" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding Paid}" OnColor="{StaticResource Primary}" />
                </Grid>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasQty}">
                <VerticalStackLayout>
                    <Label Text="Quantity" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Qty}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Unit (optional)" Style="{StaticResource SectionLabel}" />
                    <Entry Text="{Binding Unit}" Placeholder="kg, L, packs" MaxLength="20" />
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout IsVisible="{Binding IsMonthly}">
                <Label Text="{Binding PriceLabel}" Style="{StaticResource SectionLabel}" />
                <Entry Text="{Binding Price}" Keyboard="Numeric" Placeholder="0.00" />
                <Label Text="Filled in for you when you add the bill." Style="{StaticResource Subtle}" />
            </VerticalStackLayout>
            <Label Text="Notes (optional)" Style="{StaticResource SectionLabel}" />
            <Editor Text="{Binding Notes}" Placeholder="Brand, size, where to buy…" AutoSize="TextChanges" MaxLength="500" />
            <Label Text="{Binding Source}" Style="{StaticResource Subtle}" IsVisible="{Binding Source, Converter={StaticResource NotEmpty}}" />

            <Button Text="Save" Command="{Binding SaveCommand}" Margin="0,12,0,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding CanMove}">
                <Button Text="Move up" Command="{Binding MoveUpCommand}" Style="{StaticResource OutlineButton}" />
                <Button Grid.Column="1" Text="Move down" Command="{Binding MoveDownCommand}" Style="{StaticResource OutlineButton}" />
            </Grid>
            <Button Text="{Binding DeleteText}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </ScrollView>
</views:VaultPage>
