<?xml version="1.0" encoding="utf-8" ?>
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FamilyLists.App.Views"
             xmlns:vm="clr-namespace:FamilyLists.App.ViewModels"
             x:Class="FamilyLists.App.Views.GroupPage"
             x:DataType="vm:GroupViewModel"
             Title="Group">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,8,16,32" Spacing="12">

                <VerticalStackLayout IsVisible="{Binding HasGroup}" Spacing="12">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding GroupName}" Style="{StaticResource Heading}" FontSize="26" />
                            <Label Text="{Binding Status}" Style="{StaticResource Subtle}" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Sync now" Command="{Binding SyncNowCommand}" Style="{StaticResource LinkButton}" />
                                <Button Text="Rename" Command="{Binding RenameCommand}" Style="{StaticResource LinkButton}" IsVisible="{Binding IsAdmin}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Join requests waiting for approval -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pending}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PendingJoinRow">
                                <Border Style="{StaticResource Card}" Padding="14" Stroke="{StaticResource Warning}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Name, StringFormat='{0} wants to join'}" FontFamily="OpenSansSemibold" />
                                        <Label Text="Call them. Approve only if they see the same code:" Style="{StaticResource Subtle}" />
                                        <Label Text="{Binding SafetyCode}" FontSize="32" FontFamily="OpenSansSemibold" HorizontalOptions="Center" CharacterSpacing="6" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Text="Approve" Command="{Binding ApproveCommand, Source={RelativeSource AncestorType={x:Type vm:GroupViewModel}}, x:DataType=vm:GroupViewModel}" CommandParameter="{Binding .}" />
                                            <Button Grid.Column="1" Text="Decline" Style="{StaticResource DangerButton}"
                                                    Command="{Binding RejectCommand, Source={RelativeSource AncestorType={x:Type vm:GroupViewModel}}, x:DataType=vm:GroupViewModel}" CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Invite -->
                    <VerticalStackLayout IsVisible="{Binding IsAdmin}" Spacing="8">
                        <Label Text="Invite someone" Style="{StaticResource SectionLabel}" />
                        <Label Text="Next to you: show them a QR code to scan. Far away: send an invite message, then check a 6-digit code with them on a call before letting them in." Style="{StaticResource Subtle}" />
                        <Button Text="Show QR code" Command="{Binding InviteInPersonCommand}" />
                        <Button Text="Send an invite message" Command="{Binding InviteByMessageCommand}" Style="{StaticResource OutlineButton}" />
                        <Border IsVisible="{Binding ShowQr}" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12" HorizontalOptions="Center">
                            <VerticalStackLayout Spacing="6">
                                <Image Source="{Binding InviteQr}" WidthRequest="260" HeightRequest="260" />
                                <Label Text="{Binding QrExpiry}" TextColor="Black" FontSize="15" HorizontalTextAlignment="Center" WidthRequest="260" />
                                <Button Text="Done" Command="{Binding HideQrCommand}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Members -->
                    <Label Text="Members" Style="{StaticResource SectionLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemberRow">
                                <Border Style="{StaticResource Card}" Padding="14,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Subtle}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="⋯" Style="{StaticResource LinkButton}" FontSize="22" IsVisible="{Binding CanManage}"
                                                Command="{Binding ManageCommand, Source={RelativeSource AncestorType={x:Type vm:GroupViewModel}}, x:DataType=vm:GroupViewModel}" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Currency for spending" Style="{StaticResource SectionLabel}" />
                    <Picker ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" IsEnabled="{Binding IsAdmin}" />

                    <Label Text="Only this group's phones can read its lists. The relay that carries the changes sees only scrambled data." Style="{StaticResource Subtle}" />
                </VerticalStackLayout>

                <Label Text="Other groups" Style="{StaticResource SectionLabel}" />
                <Button Text="Join a group" Command="{Binding JoinCommand}" Style="{StaticResource OutlineButton}" />
                <Button Text="Start another group" Command="{Binding CreateAnotherCommand}" Style="{StaticResource OutlineButton}" />
                <Button Text="Leave this group" Command="{Binding LeaveCommand}" Style="{StaticResource DangerButton}" IsVisible="{Binding HasGroup}" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#66000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
    </Grid>
</views:VaultPage>
