<?xml version="1.0" encoding="utf-8" ?>
<views:VaultPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FamilyLists.App.Views"
             xmlns:vm="clr-namespace:FamilyLists.App.ViewModels"
             x:Class="FamilyLists.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="10">
            <Label Text="Your name" Style="{StaticResource SectionLabel}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Name}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Change" Command="{Binding RenameCommand}" Style="{StaticResource LinkButton}" />
            </Grid>

            <Label Text="Reading bills" Style="{StaticResource SectionLabel}" />
            <Label Text="{Binding ClaudeStatus}" Style="{StaticResource Subtle}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasClaudeKey}">
                <Label Text="Read bills with Claude" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UseClaude}" />
            </Grid>
            <Button Text="Add my Anthropic API key" Command="{Binding SetClaudeKeyCommand}" Style="{StaticResource OutlineButton}" IsVisible="{Binding HasClaudeKey, Converter={StaticResource Not}}" />
            <Button Text="Remove the key" Command="{Binding RemoveClaudeKeyCommand}" Style="{StaticResource LinkButton}" HorizontalOptions="Start" IsVisible="{Binding HasClaudeKey}" />

            <Label Text="Updates" Style="{StaticResource SectionLabel}" />
            <Label Text="{Binding Version}" Style="{StaticResource Subtle}" />
            <Button Text="Check for updates" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource OutlineButton}" />

            <Label Text="About" Style="{StaticResource SectionLabel}" />
            <Label Text="Family Lists is free and open source (MIT). No accounts, no ads, no tracking. Lists are stored encrypted on your phone and shared only with your groups' phones, through the free ntfy.sh relay, which only sees scrambled data. Bill text is read on your phone with Google ML Kit, unless you choose Claude above." Style="{StaticResource Subtle}" />
            <Button Text="Source code and licences" Command="{Binding OpenProjectCommand}" Style="{StaticResource LinkButton}" HorizontalOptions="Start" />

            <Button Text="Erase everything on this phone" Command="{Binding EraseCommand}" Style="{StaticResource DangerButton}" Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</views:VaultPage>
