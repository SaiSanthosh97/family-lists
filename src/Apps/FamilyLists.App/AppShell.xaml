<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FamilyLists.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FamilyLists.App.Views"
    Title="Family Lists"
    FlyoutBehavior="Disabled">

    <!-- Start: decides between first-launch setup and the main tabs. -->
    <ShellContent Route="start" ContentTemplate="{DataTemplate views:StartPage}" Shell.NavBarIsVisible="False" />
    <ShellContent Route="welcome" ContentTemplate="{DataTemplate views:WelcomePage}" Shell.NavBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent Title="Lists" Route="lists" ContentTemplate="{DataTemplate views:ListsPage}">
            <ShellContent.Icon><FontImageSource Glyph="📝" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Group" Route="group" ContentTemplate="{DataTemplate views:GroupPage}">
            <ShellContent.Icon><FontImageSource Glyph="👥" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon><FontImageSource Glyph="⚙" Size="22" /></ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
