<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:FamilyLists.App.Views"
             x:Class="FamilyLists.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:NotEmptyConverter x:Key="NotEmpty" />
            <views:NotConverter x:Key="Not" />
            <views:AnyConverter x:Key="Any" />
            <views:StrikeConverter x:Key="Strike" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
